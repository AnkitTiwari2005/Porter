{
  "name": "portex-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "migrate": "node --env-file-if-exists=.env src/migrate-cli.js",
    "create-user": "node --env-file-if-exists=.env src/cli/create-user.js",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "cookie": "^0.7.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "globals": "^15.14.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
